const accentStyles: Record<Accent, { hover: string; shadow: string }> = {
  orange: { hover: 'hover:border-brand-orange', shadow: 'hover:shadow-glow-card' },
  red: { hover: 'hover:border-brand-red', shadow: 'hover:shadow-glow-red' },
};
---

<section id='galeria' class='relative mx-auto max-w-7xl px-5 py-20 sm:px-8'>
  <div class='mx-auto mb-14 max-w-3xl text-center'>
    <div class='mb-3 inline-flex items-center gap-2'>
      <span class='h-2 w-2 animate-pulse rounded-full bg-brand-red'></span>
      <span class='font-mono text-xs uppercase tracking-widest text-brand-orange'>
        // GALERIA AUDIOVISUAL
      </span>
    </div>
    <h2
      class='mt-1 font-heading text-3xl font-extrabold uppercase tracking-tight text-white sm:text-5xl'
    >
      CONOCIMIENTO Y EXPERIENCIA COMPROBABLE
    </h2>
  </div>

  <div class='grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3'>
    {
      galleryItems.map((item) => (
        <div
          class={`group relative flex cursor-pointer flex-col justify-between overflow-hidden rounded-2xl border border-neutral-800/80 bg-brand-card transition-all duration-300 ${accentStyles[item.accent].hover} ${accentStyles[item.accent].shadow}`}
        >
          <div class='relative aspect-video w-full overflow-hidden bg-neutral-950 sm:aspect-[4/3]'>
            <img
              src={item.image}
              alt={item.alt}
              class='h-full w-full object-cover opacity-90 transition-transform duration-500 group-hover:scale-105'
              loading='lazy'
            />
            <div class='absolute inset-0 bg-gradient-to-t from-brand-black via-brand-black/30 to-transparent' />

            {item.tag && (
              <div class='absolute left-3 top-3'>
                <span
                  class={`rounded-md border border-neutral-700 bg-black/80 px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-wider backdrop-blur-md ${item.tagColor === 'red' ? 'text-brand-red' : 'text-brand-orange'}`}
                >
                  {item.tag}
                </span>
              </div>
            )}

            <div class='absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200 group-hover:opacity-100'>
              <div class='red-orange-grad flex h-12 w-12 scale-90 items-center justify-center rounded-full text-white shadow-glow-red transition-transform group-hover:scale-100'>
                <Icon name='lucide:expand' class='h-5 w-5' />
              </div>
            </div>

            {(item.title || item.subtitle) && (
              <div class='absolute bottom-3 left-3 right-3'>
                {item.title && (
                  <h3 class='font-heading text-base font-bold text-white transition-colors group-hover:text-brand-orange'>
                    {item.title}
                  </h3>
                )}
                {item.subtitle && (
                  <p class='mt-0.5 font-mono text-[11px] text-neutral-400'>{item.subtitle}</p>
                )}
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>
