---
import { Icon } from 'astro-icon/components';
---

<footer class='border-t border-neutral-800 bg-brand-black'>
  <div class='mx-auto flex max-w-7xl flex-col gap-6 px-5 py-10 sm:px-8 md:flex-row md:items-center md:justify-between'>
    <div>
      <div class='font-heading text-xl font-extrabold uppercase tracking-[-0.06em] text-white'>GUSTAV <span class='text-brand-red'>STUDIOS</span></div>
      <p class='mt-2 text-sm text-neutral-500'>Edición y producción audiovisual para marcas, creadores y negocios.</p>
    </div>

    <div class='flex items-center gap-4 text-neutral-400'>
      <a href='https://www.instagram.com/gustav_studios' target='_blank' rel='noopener noreferrer' class='rounded-full border border-neutral-800 p-2 transition hover:border-brand-orange hover:text-white' aria-label='Instagram'>
        <Icon name='lucide:instagram' class='h-4 w-4' />
      </a>
      <a href='https://www.tiktok.com/@elgustav_7' target='_blank' rel='noopener noreferrer' class='rounded-full border border-neutral-800 p-2 transition hover:border-brand-orange hover:text-white' aria-label='TikTok'>
        <Icon name='lucide:music-2' class='h-4 w-4' />
      </a>
      <a href='mailto:hola@studiosgustav.com' class='rounded-full border border-neutral-800 p-2 transition hover:border-brand-orange hover:text-white' aria-label='Email'>
        <Icon name='lucide:mail' class='h-4 w-4' />
      </a>
    </div>
  </div>
</footer>
