---
import { Icon } from 'astro-icon/components';
import Button from './ui/Button.astro';
---

<section id='hero' class='relative min-h-screen overflow-hidden bg-brand-black pt-20'>
  <div class='absolute inset-0'>
    <img
      src='/images/hero.avif'
      alt='Fondo del hero de Gustav Studios'
      class='h-full w-full object-cover opacity-30 saturate-150 contrast-125'
    />
    <div class='absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(255,92,0,0.25),transparent_55%)]'></div>
    <div class='absolute inset-0 bg-gradient-to-t from-brand-black via-brand-black/70 to-brand-black/90'></div>
  </div>
  <div class='absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:42px_42px] opacity-70'></div>

  <div class='relative mx-auto grid min-h-[calc(100vh-5rem)] w-full max-w-7xl items-center gap-8 px-5 pb-8 pt-8 text-left sm:px-8 lg:grid-cols-[1.2fr_0.8fr]'>
    <div>
      <div class='mb-6 inline-flex items-center gap-2 rounded-full border border-neutral-800 bg-neutral-950/80 px-4 py-2 text-[10px] font-mono uppercase tracking-[0.26em] text-neutral-300 backdrop-blur-md'>
        <span class='h-2.5 w-2.5 rounded-full bg-brand-red shadow-[0_0_0_0_rgba(255,7,0,0.8)] animate-pulse [animation-duration:1s]'></span>
        Disponible para proyectos
      </div>

      <h1 class='max-w-3xl font-heading text-3xl font-extrabold uppercase leading-[0.9] tracking-[-0.08em] text-white sm:text-4xl md:text-5xl lg:text-[4.6rem]'>
        <span class='block'>
          Transformo <span class='text-brand-red'>ideas</span> en
        </span>
        <span class='block bg-gradient-to-r from-brand-red via-brand-orange to-white bg-clip-text text-transparent'>
          historias que se ven.
        </span>
      </h1>

      <p class='mt-6 max-w-xl text-pretty leading-relaxed text-neutral-300 sm:text-md'>
        En Gustav Studios Somos especializado en edición de video profesional y postproducción audiovisual, enfocados en convertir
material en bruto en piezas narrativas dinámicas, estéticas y altamente efectivas. Nos encargamos de todo el proceso técnico para que
tú solo te preocupes por grabar. Con Gustav Estudios, garantizamos entregas puntuales, calidad impecable y un estilo personalizado que
se alinea perfectamente con la identidad de tu marca.
      </p>

      <div class='mt-10 flex flex-col items-start gap-4 sm:flex-row'>
        <Button href='#portfolio' variant='primary' size='lg'>
          <Icon name='lucide:play' class='h-4 w-4 fill-current' />
          Ver portafolio
        </Button>
        <Button href='#contact' variant='secondary' size='lg'>
          Trabajemos juntos
          <Icon name='lucide:arrow-right' class='h-4 w-4' />
        </Button>
      </div>
    </div>

    <div class='relative flex items-center justify-center lg:justify-end'>
      <div class='absolute inset-0 flex items-center justify-center'>
        <div class='h-72 w-72 rounded-full bg-brand-red/10 blur-3xl sm:h-80 sm:w-80'></div>
      </div>
      <img
        src='/images/logo.webp'
        alt='Logo de Gustav Studios'
        class='relative z-10 h-[13.6rem] w-auto rounded-2xl border border-white/10 bg-white/3 p-5 shadow-[0_0_45px_rgba(255,92,0,0.18)] backdrop-blur-sm sm:h-[17.4rem] md:h-[19.8rem] lg:h-[22.2rem]'
      />
    </div>
  </div>

