---
import { Icon } from 'astro-icon/components';
import Button from './ui/Button.astro';
---

<section id='hero' class='relative overflow-hidden bg-brand-black pt-28'>
  <div class='absolute inset-0'>
    <img
      src='/images/hero.avif'
      alt='Fondo del hero de Gustav Studios'
      class='h-full w-full object-cover opacity-30 saturate-150 contrast-125'
    />
    <div class='absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(255,92,0,0.25),transparent_55%)]'></div>
    <div class='absolute inset-0 bg-gradient-to-t from-brand-black via-brand-black/70 to-brand-black/90'></div>
  </div>
  <div class='absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:42px_42px] opacity-70'></div>

  <div class='relative mx-auto flex max-w-7xl flex-col items-center px-5 pb-16 pt-12 text-center sm:px-8'>
    <div class='mb-6 inline-flex items-center gap-2 rounded-full border border-neutral-800 bg-neutral-950/80 px-4 py-2 text-[10px] font-mono uppercase tracking-[0.26em] text-neutral-300 backdrop-blur-md'>
      <span class='h-2.5 w-2.5 rounded-full bg-brand-red shadow-[0_0_0_0_rgba(255,7,0,0.8)] animate-pulse [animation-duration:1s]'></span>
      Disponible para proyectos
    </div>

    <h1 class='max-w-5xl font-heading text-4xl font-extrabold uppercase leading-[0.9] tracking-[-0.08em] text-white sm:text-5xl md:text-6xl lg:text-[6rem]'>
      <span class='block'>
        Transformo <span class='text-brand-red'>ideas</span> en
      </span>
      <span class='block bg-gradient-to-r from-brand-red via-brand-orange to-white bg-clip-text text-transparent'>
        historias que se ven.
      </span>
    </h1>

    <p class='mt-6 max-w-2xl text-base leading-relaxed text-neutral-300 sm:text-xl'>
      Producción y edición audiovisual con enfoque comercial, emocional y de alta conversión para marcas, creadores y negocios digitales.
    </p>

    <div class='mt-10 flex flex-col items-center gap-4 sm:flex-row'>
      <Button href='#portfolio' variant='primary' size='lg'>
        <Icon name='lucide:play' class='h-4 w-4 fill-current' />
        Ver portafolio
      </Button>
      <Button href='#contact' variant='secondary' size='lg'>
        Trabajemos juntos
        <Icon name='lucide:arrow-right' class='h-4 w-4' />
      </Button>
    </div>

    <div class='mt-12 grid w-full max-w-4xl grid-cols-2 gap-4 md:grid-cols-4'>
      <div class='rounded-2xl border border-neutral-800 bg-neutral-950/70 p-4'>
        <div class='font-heading text-3xl font-extrabold text-white'>120+</div>
        <div class='mt-2 font-mono text-[10px] uppercase tracking-[0.2em] text-neutral-400'>Proyectos</div>
      </div>
      <div class='rounded-2xl border border-neutral-800 bg-neutral-950/70 p-4'>
        <div class='font-heading text-3xl font-extrabold text-white'>4K</div>
        <div class='mt-2 font-mono text-[10px] uppercase tracking-[0.2em] text-neutral-400'>Edición</div>
      </div>
      <div class='rounded-2xl border border-neutral-800 bg-neutral-950/70 p-4'>
        <div class='font-heading text-3xl font-extrabold text-white'>7 años</div>
        <div class='mt-2 font-mono text-[10px] uppercase tracking-[0.2em] text-neutral-400'>Experiencia</div>
      </div>
      <div class='rounded-2xl border border-neutral-800 bg-neutral-950/70 p-4'>
        <div class='font-heading text-3xl font-extrabold text-white'>24/7</div>
        <div class='mt-2 font-mono text-[10px] uppercase tracking-[0.2em] text-neutral-400'>Atención</div>
      </div>
    </div>
  </div>
</section>
