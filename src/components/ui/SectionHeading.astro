---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
const alignClass = align === 'center' ? 'mx-auto text-center items-center' : '';
---

<div class:list={['mb-10 flex max-w-3xl flex-col gap-3', alignClass]}>
  <span class='font-mono text-[11px] uppercase tracking-[0.28em] text-brand-orange'>{eyebrow}</span>
  <h2 class='font-heading text-3xl font-extrabold uppercase tracking-[-0.05em] text-white sm:text-4xl md:text-5xl'>
    {title}
  </h2>
  {description && <p class='max-w-2xl text-sm leading-relaxed text-neutral-400 sm:text-base'>{description}</p>}
</div>
