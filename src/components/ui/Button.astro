---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { href = '#', variant = 'primary', size = 'md', class: customClass = '' } = Astro.props;

const variantClass = {
  primary: 'bg-gradient-to-r from-brand-red to-brand-orange text-white shadow-[0_0_30px_rgba(255,92,0,0.35)] hover:-translate-y-0.5 hover:shadow-[0_0_35px_rgba(255,92,0,0.5)]',
  secondary: 'border border-neutral-700 bg-neutral-900/80 text-neutral-200 hover:border-brand-orange hover:text-white',
  ghost: 'text-neutral-200 hover:text-white',
}[variant];

const sizeClass = {
  sm: 'px-4 py-2 text-xs',
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-4 text-sm',
}[size];
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-xl font-heading font-bold uppercase tracking-[0.12em] transition-all duration-200',
    variantClass,
    sizeClass,
    customClass,
  ]}
>
  <slot />
</a>
