---
import { getCollection } from 'astro:content';

import '../styles/global.css';
import AboutSection from '../components/AboutSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import GallerySection from '../components/GallerySection.astro';
import Hero from '../components/Hero.astro';
import Navbar from '../components/Navbar.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import ProcessSection from '../components/ProcessSection.astro';
import ServicesSection from '../components/ServicesSection.astro';

const videos = (await getCollection('videos')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));

const SITE_URL = 'https://studiosgustav.com';
const seoTitle = 'GUSTAV STUDIOS | Producción, edición y postproducción audiovisual en Lima';
const seoDescription =
  'GUSTAV STUDIOS crea contenido audiovisual para marcas, negocios y creadores: reels, podcast, videos corporativos, edición de video y producción audiovisual en Lima, Perú.';
const ogImage = `${SITE_URL}/images/logo.webp`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'GUSTAV STUDIOS',
  description: seoDescription,
  url: `${SITE_URL}/`,
  logo: ogImage,
  image: ogImage,
  telephone: '+51943604589',
  email: 'studiosgustav@gmail.com',
  areaServed: 'PE',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lima',
    addressCountry: 'PE',
  },
  sameAs: ['https://www.instagram.com/gustav_studios', 'https://www.tiktok.com/@elgustav_7'],
  knowsAbout: [
    'Producción audiovisual',
    'Edición de video',
    'Videos para redes sociales',
    'Edición de podcast',
    'Postproducción y color grading',
    'Contenido para marcas y negocios',
  ],
};
---

<html lang='es'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>{seoTitle}</title>
    <meta name='description' content={seoDescription} />
    <meta name='robots' content='index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' />
    <meta name='author' content='GUSTAV STUDIOS' />
    <meta name='keywords' content='producción audiovisual, edición de video, reels, podcast, contenido para redes sociales, Lima Perú, GUSTAV STUDIOS' />
    <meta name='generator' content={Astro.generator} />
    <link rel='canonical' href={`${SITE_URL}/`} />

    <meta name='theme-color' content='#050505' />
    <link rel='icon' type='image/webp' href='/images/logo.webp' />
    <link rel='apple-touch-icon' href='/images/logo.webp' />

    <meta name='geo.region' content='PE' />
    <meta name='geo.placename' content='Lima, Perú' />

    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='GUSTAV STUDIOS' />
    <meta property='og:locale' content='es_PE' />
    <meta property='og:title' content={seoTitle} />
    <meta property='og:description' content={seoDescription} />
    <meta property='og:url' content={`${SITE_URL}/`} />
    <meta property='og:image' content={ogImage} />
    <meta property='og:image:type' content='image/webp' />
    <meta property='og:image:width' content='512' />
    <meta property='og:image:height' content='512' />
    <meta property='og:image:alt' content='Logo de GUSTAV STUDIOS' />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={seoTitle} />
    <meta name='twitter:description' content={seoDescription} />
    <meta name='twitter:image' content={ogImage} />

    <script type='application/ld+json' set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <!-- Ambient Glow Elements -->
    <div
      class='radial-flare pointer-events-none fixed left-1/2 top-0 z-0 h-125 w-200 -translate-x-1/2'
    >
    </div>
    <div
      class='pointer-events-none fixed -bottom-40 -right-40 z-0 h-150 w-150 bg-brand-orange/5 blur-[140px]'
    >
    </div>
    <div
      class='pointer-events-none fixed -left-40 top-1/2 z-0 h-125 w-125 bg-brand-red/5 blur-[140px]'
    >
    </div>
    <Navbar />
    <main class='relative z-10 overflow-hidden text-white'>
      <Hero />
      <PortfolioGrid videos={videos} />
      <ServicesSection />
      <AboutSection />
      <GallerySection />
      <ProcessSection />
      <ContactSection />
    </main>
    <Footer />
  </body>
</html>
